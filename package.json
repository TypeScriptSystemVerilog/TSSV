{
  "name": "tssv",
  "type": "module",
  "version": "1.0.0",
  "description": "Typescript based SystemVerilog meta-language and HDL design framework",
  "main": "./out/src/TSSV.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "docs": "typedoc && node scripts/render-wavedrom.mjs doc/reference/*.md",
    "check:body": "bash scripts/check-body-appends.sh",
    "lint:sv": "bash scripts/lint-sv.sh",
    "lint:style-examples": "node doc/rtl-style/sv-style/tools/lint-style-examples.mjs",
    "check:rtl-style": "node doc/rtl-style/sv-style/tools/check-rtl-style.mjs",
    "render:wavedrom": "node scripts/render-wavedrom.mjs",
    "check:wavedrom": "node scripts/render-wavedrom.mjs --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TypeScriptSystemVerilog/TSSV.git"
  },
  "keywords": [
    "Typescript",
    "SystemVerilog",
    "Verilog",
    "HDL"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/TypeScriptSystemVerilog/TSSV/issues"
  },
  "exports": {
    "./lib/modules/*": ["./out/src/modules/*/index.js", "./out/src/modules/*.js"],
    "./lib/*": "./out/src/*.js",
    "./test/*": "./out/test/*.js"
  },
  "typesVersions": {
    "*": {
      "lib/modules/*": ["out/src/modules/*/index", "out/src/modules/*"],
      "lib/*": ["out/src/*"],
      "test/*": ["out/test/*"]
    }
  },
  "homepage": "https://github.com/TypeScriptSystemVerilog/TSSV#readme",
  "devDependencies": {
    "@types/deep-diff": "^1.0.5",
    "@types/node": "^20.11.22",
    "eslint": "^8.57.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typedoc-plugin-no-inherit": "^1.6.1",
    "typescript": "^5.4.2",
    "wavedrom": "^3.7.0"
  },
  "dependencies": {
    "deep-diff": "^1.0.2",
    "eslint-config-love": "^43.1.0",
    "fast-xml-parser": "^4.4.0",
    "typescript-eslint": "^7.4.0"
  }
}
